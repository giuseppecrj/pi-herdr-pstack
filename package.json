{
  "name": "pi-herdr-pstack",
  "version": "0.1.0-experimental.0",
  "private": true,
  "description": "Experimental pstack methodology pack for pi-herdr-agents: poteto-mode and setup-pstack (Wave 2 candidate)",
  "keywords": [
    "pi-package",
    "pi",
    "herdr",
    "subagents",
    "pstack"
  ],
  "license": "MIT",
  "author": {
    "name": "Giuseppe Rodriguez",
    "url": "https://github.com/giuseppecrj"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giuseppecrj/pi-herdr-pstack.git"
  },
  "homepage": "https://github.com/giuseppecrj/pi-herdr-pstack#readme",
  "bugs": {
    "url": "https://github.com/giuseppecrj/pi-herdr-pstack/issues"
  },
  "type": "module",
  "files": [
    "pi-extension/",
    "skills/",
    "docs/compatibility.md",
    "docs/provenance.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "RELEASING.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "changelog": "auto-changelog",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "format": "biome format --write pi-extension test",
    "format:check": "biome format pi-extension test",
    "lint": "oxlint pi-extension test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test --test-concurrency=1 test/*.test.ts",
    "version": "auto-changelog --package && git add CHANGELOG.md"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "pi-herdr-agents": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/pstack/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@types/node": "^22.20.5",
    "auto-changelog": "^2.6.0",
    "oxlint": "^1.80.0",
    "typescript": "5.9.3"
  },
  "auto-changelog": {
    "commitLimit": false,
    "template": "keepachangelog",
    "unreleased": true
  }
}
